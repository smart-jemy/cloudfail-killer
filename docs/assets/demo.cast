[0.8, "o", "\u001b[38;5;114m$ \u001b[0mcloudkill --version\r\n"]
[1.25, "o", "cloudkill v0.7.0\r\n"]
[1.3, "o", "\r\n"]
[2.2, "o", "\u001b[38;5;114m$ \u001b[0mcloudkill --help\r\n"]
[2.65, "o", "                                                                                \r\n"]
[2.7, "o", " Usage: cloudkill [OPTIONS] [COMMAND] [ARGS]...                                 \r\n"]
[2.75, "o", "                                                                                \r\n"]
[2.8, "o", " CloudFail-Killer: Discover origin IPs behind Cloudflare                        \r\n"]
[2.85, "o", "                                                                                \r\n"]
[2.9, "o", "\u256d\u2500 Options \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\r\n"]
[2.95, "o", "\u2502 --version             -v        Show version and exit                        \u2502\r\n"]
[3.0, "o", "\u2502 --install-completion            Install completion for the current shell.    \u2502\r\n"]
[3.05, "o", "\u2502 --show-completion               Show completion for the current shell, to    \u2502\r\n"]
[3.1, "o", "\u2502                                 copy it or customize the installation.       \u2502\r\n"]
[3.15, "o", "\u2502 --help                          Show this message and exit.                  \u2502\r\n"]
[3.2, "o", "\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\r\n"]
[3.25, "o", "\u256d\u2500 Commands \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\r\n"]
[3.3, "o", "\u2502 scan      Scan a domain to discover origin IPs behind Cloudflare.            \u2502\r\n"]
[3.35, "o", "\u2502 sign      Sign a report with ed25519 \u2014 the client can prove it was never     \u2502\r\n"]
[3.4, "o", "\u2502           altered.                                                           \u2502\r\n"]
[3.45, "o", "\u2502 verify    Verify a signed report \u2014 fails on ANY byte-level alteration.       \u2502\r\n"]
[3.5, "o", "\u2502 profiles  List available scan profiles with descriptions.                    \u2502\r\n"]
[3.55, "o", "\u2502 sources   List available data sources and their status.                      \u2502\r\n"]
[3.6, "o", "\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\r\n"]
[3.65, "o", "\r\n"]
[4.55, "o", "\u001b[38;5;114m$ \u001b[0mcloudkill profiles\r\n"]
[5.0, "o", "Available Scan Profiles:\r\n"]
[5.05, "o", "\r\n"]
[5.1, "o", "  researcher\r\n"]
[5.15, "o", "    Goal:     Comprehensive data collection with high accuracy\r\n"]
[5.2, "o", "    Output:   JSON + CSV\r\n"]
[5.25, "o", "    Features: Multi-source, historical, smart scoring\r\n"]
[5.3, "o", "\r\n"]
[5.35, "o", "  pentester\r\n"]
[5.4, "o", "    Goal:     Fast actionable results\r\n"]
[5.45, "o", "    Output:   CLI Table + Nuclei\r\n"]
[5.5, "o", "    Features: Tuned scoring weights; combine with --active for probing\r\n"]
[5.55, "o", "\r\n"]
[5.6, "o", "  bugbounty\r\n"]
[5.65, "o", "    Goal:     Discover hidden origins\r\n"]
[5.7, "o", "    Output:   Markdown + Slack\r\n"]
[5.75, "o", "    Features: JS-Recon-weighted scoring, historical leaks\r\n"]
[5.8, "o", "\r\n"]
[5.85, "o", "  enterprise\r\n"]
[5.9, "o", "    Goal:     Infrastructure monitoring\r\n"]
[5.95, "o", "    Output:   PDF + JSON\r\n"]
[6.0, "o", "    Features: PDF report auto-added, SQLite history\r\n"]
[6.05, "o", "\r\n"]
[6.1, "o", "  automation\r\n"]
[6.15, "o", "    Goal:     CI/CD integration\r\n"]
[6.2, "o", "    Output:   JSON + Stdout\r\n"]
[6.25, "o", "    Features: Machine-readable output, clean exit codes\r\n"]
[6.3, "o", "\r\n"]
